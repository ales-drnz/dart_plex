# pubignore — overrides .gitignore when present; mirror dev-only paths here.

# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
**/doc/api/
build/
coverage/
pubspec.lock

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Docs
docs/

# AI tooling
.claude/
CLAUDE.md

# Tests
test/
dart_test.yaml
.env.test

# Branding stays on GitHub: the README loads the diagrams from there. Only
# the icon ships, as the pubspec screenshot.
/imgs/*
!/imgs/dart_plex.png

# Dev tools: the transport drift check and the icon and diagram generator
/tool/
